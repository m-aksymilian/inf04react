    ],
    "description": "shuffle array (Fisher-Yates, returns a NEW array) (06_js_helpers.jsx)",
    "body": [
      "function tasuj(tablica) {",
      "  const kopia = [...tablica];",
      "  for (let i = kopia.length - 1; i > 0; i--) {",
      "    const j = Math.floor(Math.random() * (i + 1));",
      "    [kopia[i], kopia[j]] = [kopia[j], kopia[i]];",
      "  }",
      "  return kopia;",
      "}"
    ]
  },
