      "const kursy = ['Programowanie w C#', 'Angular dla początkujących', 'Kurs Django'];",
      "const [numer, setNumer] = useState('');",
      "",
      "function zapisz(e) {",
      "  e.preventDefault();",
      "  const n = Number(numer);     // input value is ALWAYS a string",
      "  if (n >= 1 && n <= kursy.length) {",
      "    console.log(kursy[n - 1]);",
