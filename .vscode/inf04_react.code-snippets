      "  return tekst.charAt(0).toUpperCase() + tekst.slice(1).toLowerCase();",
      "}",
      "",
      "function odwroc(tekst) {",
      "  return tekst.split('').reverse().join('');",
      "}",
      "",
      "function czyPalindrom(tekst) {",
