    "description": "ONE object state for many fields, handler uses e.target.name – LOGIC (above return) | needs useState",
    "body": [
      "// FORM-11 ONE object state for many fields, handler uses e.target.name",
      "const [dane, setDane] = useState({ imie: '', email: '', wiek: '' });",
      "",
      "function zmien(e) {",
      "  setDane({ ...dane, [e.target.name]: e.target.value });   // name attr = key in the object",
      "}",
      "",
      "function wyslij(e) {",
      "  e.preventDefault();",
      "  console.log(dane);",
      "}"
    ]
  },
